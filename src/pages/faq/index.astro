---
import Layout from "../../layouts/Layout.astro";
import { appFaqs } from "../../data/app-faq";
import { links, site } from "../../site.config";

const title = "안전신문고 자주하는 질문";
const description =
  "안전신문고 처리결과, 아이디 찾기, 불법주정차·어린이보호구역 전화 신고, 신고 취하, 앱이 안 열릴 때까지. 이용할 때 막히는 질문을 짧게 풀어 두었습니다.";
const keywords =
  "안전신문고 FAQ, 안전신문고 자주하는 질문, 안전신문고 처리결과, 불법주정차 전화 신고, 어린이보호구역 전화 신고, 안전신문고 취하";

const faqLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: appFaqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
});

const crumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: site.name, item: `${site.baseUrl}/` },
    { "@type": "ListItem", position: 2, name: title, item: `${site.baseUrl}/faq/` },
  ],
});
---

<Layout title={title} description={description} keywords={keywords}>
  <script type="application/ld+json" set:html={faqLd} />
  <script type="application/ld+json" set:html={crumbLd} />

  <article>
    <p class="crumb">
      <a href="/">안내</a>
      <span aria-hidden="true"> / </span>
      안전신문고
    </p>

    <header class="page-hero">
      <h1>안전신문고</h1>
      <p class="lede">
        불법주정차는 이 앱에서만 접수됩니다. 설치 방법과, 결과가 안 보이거나 앱이 안 열릴 때의 답을 모아 두었습니다.
      </p>
    </header>

    <section class="panel">
      <h2>앱 설치</h2>
      <ol class="ol">
        <li>안드로이드는 구글플레이, 아이폰은 앱스토어에서 안전신문고를 받습니다.</li>
        <li>본인 인증으로 로그인한 뒤, 불법주정차는 앱 카메라로 찍습니다. 웹에서는 주정차 신고 화면이 열리지 않습니다.</li>
      </ol>
      <div class="actions">
        <a class="btn btn-stamp btn-block" href={links.safetyAppPlay} target="_blank" rel="noopener">구글플레이</a>
        <a class="btn btn-ghost btn-block" href={links.safetyAppIos} target="_blank" rel="noopener">앱스토어</a>
      </div>
    </section>

    <ul class="faq-list">
      {
        appFaqs.map((item) => (
          <li>
            <a href={`/faq/${item.slug}/`}>
              <strong>{item.toc}</strong>
              <span class="faq-hint">{item.hint}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </article>
</Layout>
