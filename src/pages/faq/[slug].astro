---
import Layout from "../../layouts/Layout.astro";
import { appFaqs, getAppFaq, relatedFaqs } from "../../data/app-faq";
import { links, site } from "../../site.config";

export function getStaticPaths() {
  return appFaqs.map((item) => ({ params: { slug: item.slug } }));
}

const item = getAppFaq(Astro.params.slug ?? "");
if (!item) throw new Error("Unknown FAQ");

const related = relatedFaqs(item);
const pageUrl = `${site.baseUrl}/faq/${item.slug}/`;

const faqLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    },
  ],
});

const crumbLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: site.name, item: `${site.baseUrl}/` },
    { "@type": "ListItem", position: 2, name: "자주하는 질문", item: `${site.baseUrl}/faq/` },
    { "@type": "ListItem", position: 3, name: item.toc, item: pageUrl },
  ],
});
---

<Layout title={item.title} description={item.description} keywords={item.keywords}>
  <script type="application/ld+json" set:html={faqLd} />
  <script type="application/ld+json" set:html={crumbLd} />

  <article class="faq-article">
    <p class="crumb">
      <a href="/faq/">자주하는 질문</a>
      <span aria-hidden="true"> / </span>
      {item.toc}
    </p>

    <header class="page-hero">
      <h1>{item.h1}</h1>
      <p class="lede">{item.answer}</p>
    </header>

    <div class="faq-guide">
      {
        item.blocks.map((block) => {
          if (block.type === "p") return <p>{block.text}</p>;
          if (block.type === "note") {
            return (
              <p class="faq-note">
                {block.text}
              </p>
            );
          }
          return (
            <section class="panel">
              <h2>{block.title}</h2>
              <ol class="ol">
                {block.items.map((step) => (
                  <li>{step}</li>
                ))}
              </ol>
            </section>
          );
        })
      }
    </div>

    {
      item.phone && (
        <p class="faq-phone">
          운영센터 <a href={`tel:${item.phone}`}>{item.phone}</a>
        </p>
      )
    }

    {
      related.length > 0 && (
        <section class="panel">
          <h2>같이 보면 좋은 질문</h2>
          <ul class="faq-related">
            {related.map((faq) => (
              <li>
                <a href={`/faq/${faq.slug}/`}>{faq.toc}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="notice">
      행정안전부 안전신문고 이용 FAQ를 바탕으로, 찾기 쉽게 다시 적었습니다. 접수·처분은 공식 앱과 처리기관 기준입니다.
    </p>

    <div class="cta-end">
      <a class="btn btn-ghost btn-block" href="/faq/">다른 질문 보기</a>
      <a class="btn btn-ghost btn-block" href={links.safetyApp}>안전신문고 앱 설치</a>
      <a class="btn btn-ghost btn-block" href={links.safety} target="_blank" rel="noopener">
        안전신문고 누리집
      </a>
    </div>
  </article>
</Layout>
