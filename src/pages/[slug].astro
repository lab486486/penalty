---
import Layout from "../layouts/Layout.astro";
import ReportCta from "../components/ReportCta.astro";
import ShareButton from "../components/ShareButton.astro";
import { getTopic, maxFineLabel, rowAmount, topics } from "../data/topics";
import { explainFor } from "../data/explain";
import { getTopicSeo } from "../data/seo";
import { site } from "../site.config";

export function getStaticPaths() {
  return topics.filter((topic) => topic.slug !== "bounty").map((topic) => ({ params: { slug: topic.slug } }));
}

const topic = getTopic(Astro.params.slug ?? "");
if (!topic) throw new Error(`Unknown: ${Astro.params.slug}`);
const seo = getTopicSeo(topic.slug);
const title = seo?.title ?? topic.title;
const description = seo?.description
  ?? `${topic.title} 과태료 ${maxFineLabel(topic)}. 접수 창구와 신고가 되는 조건을 정리했습니다.`;
const keywords = [...topic.keywords, topic.title].join(", ");
const faq = seo?.faq ?? [];
const explain = explainFor(topic.slug);
const faqLd = faq.length
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: { "@type": "Answer", text: item.a },
      })),
    })
  : "";
---

<Layout title={title} description={description} keywords={keywords} ads>
  {faqLd && <script type="application/ld+json" set:html={faqLd} />}
  <article>
    <p class="crumb">
      <a href="/">안내</a>
      <span aria-hidden="true"> / </span>
      {topic.title}
    </p>

    <header class="page-hero">
      <h1>{topic.title}</h1>
      {seo && <p class="lede">{seo.description}</p>}
    </header>

    <section class="penalty" aria-label="과태료">
      <div class="penalty-head">
        <p class="penalty-kicker">과태료 범위</p>
        <ShareButton
          title={topic.title}
          text={`과태료 ${topic.penaltyLead}`}
          url={new URL(`/${topic.slug}/`, site.baseUrl).href}
        />
      </div>
      <p class="penalty-lead">{maxFineLabel(topic)}</p>
      <p class="penalty-note">{topic.penaltyNote}</p>
      {topic.amounts.length > 0 && (
        <ul class="amount-list">
          {topic.amounts.map((row) => (
            <li>
              <span>{row.where}</span>
              <strong>{rowAmount(row)}</strong>
            </li>
          ))}
        </ul>
      )}
    </section>

    {
      explain.map((block) => (
        <section class="panel guide-prose">
          <h2>{block.title}</h2>
          {block.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      ))
    }

    {
      topic.guides?.map((guide) => (
        <section class="panel">
          <h2>{guide.title}</h2>
          {guide.intro && <p class="guide-intro">{guide.intro}</p>}
          <ol class="ol">
            {guide.items.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </section>
      ))
    }

    {topic.appOnly && (
      <section class="panel">
        <h2>앱으로 접수합니다</h2>
        <p>불법주정차는 안전신문고 웹이 아니라 앱 카메라로만 접수됩니다.</p>
        <ol class="ol">
          <li>앱을 설치하고 본인 인증으로 로그인합니다.</li>
          <li>불법주정차를 고르고, 번호판과 위반 장소가 한 장에 보이게 앱 카메라로 찍습니다.</li>
          <li>같은 자리, 같은 각도로 1분이 지난 뒤 두 번째 장을 찍습니다.</li>
        </ol>
      </section>
    )}

    <section class="panel">
      <h2>이럴 때 신고가 됩니다</h2>
      <ol class="ol">
        {topic.valid.map((item) => (
          <li>{item}</li>
        ))}
      </ol>
    </section>

    <section class="panel">
      <h2>이러면 접수되지 않습니다</h2>
      <ol class="ol">
        {topic.invalid.map((item) => (
          <li>{item}</li>
        ))}
      </ol>
    </section>

    {topic.officeCheck && (
      <section class="panel">
        <h2>포상금과 명절 단속</h2>
        <p>{topic.officeCheck}</p>
      </section>
    )}

    {faq.length > 0 && (
      <section class="panel">
        <h2>같이 나오는 질문</h2>
        <div class="faq">
          {faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <ReportCta topic={topic} hint />
  </article>
</Layout>
