---
import Layout from "../../layouts/Layout.astro";
import { getOffice, offices } from "../../data/offices";

export function getStaticPaths() {
  return offices.map((o) => ({ params: { slug: o.slug } }));
}

const office = getOffice(Astro.params.slug ?? "");
if (!office) throw new Error("Unknown office");

const title = `${office.hall} 홈페이지 · 포상금·명절 단속`;
const description = `${office.hall}에서 포상금 금액, 받는 법, 명절·공휴일 불법주정차 단속을 확인하세요.`;
---

<Layout title={title} description={description} keywords={`${office.hall}, ${office.hall} 홈페이지, ${office.name} 포상금, ${office.name} 포상금 받는법, ${office.name} 명절 불법주정차`}>
  <article>
    <p class="crumb">
      <a href="/offices/">시·군청 바로가기</a>
      <span aria-hidden="true"> / </span>
      {office.hall}
    </p>

    <header class="page-hero">
      <h1>{office.hall} 홈페이지</h1>
      <p class="lede">
        포상금 금액, 받는 법, 명절·공휴일 불법주정차 단속은 {office.hall}에서 확인하세요.
      </p>
    </header>

    <section class="panel">
      <h2>여기서 확인하는 것</h2>
      <ol class="ol">
        <li>쓰레기 무단투기·담배꽁초, 시·군이 운영하는 주정차 포상의 금액과 받는 법</li>
        <li>추석·설 등 명절·공휴일 불법주정차 단속 여부</li>
        <li>과태료 부과 담당 부서(보통 청소과·교통과)</li>
      </ol>
    </section>

    <div class="cta-end">
      <a class="btn btn-stamp btn-block" href={office.href} target="_blank" rel="noopener">
        {office.hall} 공식 사이트
      </a>
      <a class="btn btn-ghost btn-block" href="/offices/">다른 시·군청 보기</a>
    </div>
  </article>
</Layout>
