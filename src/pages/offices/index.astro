---
import Layout from "../../layouts/Layout.astro";
import { officeRegions, officesIn, regionAnchor } from "../../data/offices";
---

<Layout
  title="시·군청 바로가기 · 포상금·명절 단속"
  description="지역별 포상금 금액, 받는 법, 명절·공휴일 불법주정차 단속은 시청·군청에서 확인하세요. 전국 시청·군청 공식 홈페이지로 바로 갑니다."
  keywords="시청 홈페이지, 군청 홈페이지, 포상금 받는법, 무단투기 포상금, 명절 불법주정차, 공휴일 단속"
>
  <article class="offices-page">
    <header class="page-hero">
      <h1>시·군청 바로가기</h1>
      <p class="lede">
        포상금 금액, 받는 법, 명절·공휴일 불법주정차 단속은 시·군청이 정합니다. 원하는 청을 고르면 안내 페이지를 거쳐 공식 사이트로 갑니다.
      </p>
    </header>

    <nav class="region-jump" aria-label="지역 바로가기">
      {
        officeRegions.map((region) => (
          <a class="region-tag" href={`#${regionAnchor[region]}`} title={region}>{region === "특별·광역시" ? "특·광역시" : region}</a>
        ))
      }
    </nav>

    {
      officeRegions.map((region) => (
        <section class="panel office-region" id={regionAnchor[region]}>
          <h2>{region}</h2>
          <ul class="office-grid">
            {officesIn(region).map((o) => (
              <li>
                <a href={`/offices/${o.slug}/`}>{o.hall}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </article>
</Layout>
