---
import { site } from "../site.config";
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <span class="brand-mark">{site.name.toUpperCase()}</span>
      <span class="brand-sub">신고·포상금 가이드</span>
    </a>
    <nav class="nav-links" aria-label="바로가기">
      <a href="/illegal-parking/">불법주정차</a>
      <a href="/dumping/">무단투기</a>
      <a href="/faq/">안전신문고</a>
    </nav>
    <details class="nav-menu">
      <summary class="nav-toggle" aria-label="사이트 메뉴">
        <span class="nav-burger" aria-hidden="true"></span>
      </summary>
      <nav class="nav-panel" aria-label="바로가기">
        <a href="/illegal-parking/">
          <strong>불법주정차</strong>
          <span>과태료와 촬영 조건</span>
        </a>
        <a href="/dumping/">
          <strong>무단투기</strong>
          <span>쓰레기·꽁초</span>
        </a>
        <a href="/faq/">
          <strong>안전신문고</strong>
          <span>앱 설치와 처리결과</span>
        </a>
      </nav>
    </details>
  </div>
</header>

<script>
  document.addEventListener("click", (event) => {
    const menu = document.querySelector(".nav-menu");
    if (!(menu instanceof HTMLDetailsElement) || !menu.open) return;
    if (!menu.contains(event.target as Node)) menu.open = false;
  });
</script>
