---
import { affiliateFor } from "../data/affiliates";
import { links } from "../site.config";
import type { Topic } from "../data/topics";
import DealCard from "./DealCard.astro";

interface Props {
  topic: Topic;
  hint?: boolean;
  deal?: boolean;
}

const { topic, hint = false, deal = false } = Astro.props;
const internal = topic.href.startsWith("/");
const offer = deal ? affiliateFor(topic.category) : undefined;
---

<div class="cta-end">
  {hint && topic.appHint && <p class="notice">{topic.appHint}</p>}
  {offer && <DealCard offer={offer} />}
  <a
    class="btn btn-stamp btn-block"
    href={topic.href}
    target={internal ? undefined : "_blank"}
    rel={internal ? undefined : "noopener"}
  >
    {topic.cta}
  </a>
  {!topic.appOnly && (
    <a class="btn btn-ghost btn-block" href={links.safetyApp}>
      안전신문고 앱 설치
    </a>
  )}
</div>
